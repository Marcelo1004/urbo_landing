@keyframes float-logo{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}

.orbit-ring{
  position:absolute;
  border-radius:50%;border:1px solid rgba(0,201,167,0.1);
  animation:spin linear infinite;
}
.orbit-1{width:400px;height:400px;animation-duration:30s}
.orbit-2{width:500px;height:500px;animation-duration:45s;border-style:dashed;opacity:0.5}
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

.orbit-dot{
  position:absolute;
