  right:-200px;top:-200px;pointer-events:none;
}
.hero-glow-2{
  position:absolute;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(244,196,48,0.06) 0%,transparent 65%);
  left:-100px;bottom:-100px;pointer-events:none;
}

.hero-inner{
  max-width:1180px;margin:0 auto;padding:0 2rem;
