}

.hero-sub{
  font-size:1.05rem;font-weight:400;color:var(--mist);
  line-height:1.75;max-width:500px;margin-bottom:2.25rem;
}

.hero-ctas{display:flex;align-items:center;gap:1.1rem;flex-wrap:wrap;margin-bottom:3rem}

.btn-solid{
  background:linear-gradient(135deg,var(--teal3),var(--teal));
  color:var(--navy);font-weight:700;font-size:0.95rem;
  padding:0.85rem 2rem;border-radius:100px;
  display:inline-flex;align-items:center;gap:0.5rem;
  transition:all 0.25s;box-shadow:0 4px 24px rgba(0,201,167,0.3);
}
.btn-solid:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,201,167,0.4)}

.btn-outline{
  border:1px solid rgba(255,255,255,0.15);
  color:var(--offwhite);font-weight:500;font-size:0.9rem;
  padding:0.85rem 1.75rem;border-radius:100px;
  display:inline-flex;align-items:center;gap:0.5rem;
  transition:all 0.25s;
}
.btn-outline:hover{border-color:rgba(0,201,167,0.4);color:var(--teal)}

.hero-proof{
  display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;
}
.proof-item{
  display:flex;align-items:center;gap:0.5rem;
  font-size:0.8rem;color:var(--mist);font-weight:500;
}
.proof-dot{
  width:6px;height:6px;border-radius:50%;background:var(--teal);
  animation:blink 2s ease-in-out infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}

/* HERO LOGO VISUAL */
.hero-visual{
  display:flex;justify-content:center;align-items:center;
  position:relative;
}
.logo-showcase{
  position:relative;display:flex;align-items:center;justify-content:center;
}
.logo-showcase-img{
  width:340px;height:340px;object-fit:contain;
  filter:drop-shadow(0 0 60px rgba(0,201,167,0.25));
  animation:float-logo 4s ease-in-out infinite;
}
@keyframes float-logo{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}

.orbit-ring{
  position:absolute;
  border-radius:50%;border:1px solid rgba(0,201,167,0.1);
  animation:spin linear infinite;
}
.orbit-1{width:400px;height:400px;animation-duration:30s}
.orbit-2{width:500px;height:500px;animation-duration:45s;border-style:dashed;opacity:0.5}
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

.orbit-dot{
  position:absolute;
  width:10px;height:10px;background:var(--teal);border-radius:50%;
  top:-5px;left:50%;transform:translateX(-50%);
  box-shadow:0 0 12px rgba(0,201,167,0.8);
}
.orbit-dot-amber{background:var(--amber);box-shadow:0 0 12px rgba(244,196,48,0.8)}

/* Floating data pills around logo */
.float-pill{
  position:absolute;
  background:rgba(15,28,53,0.95);
  border:1px solid rgba(0,201,167,0.2);
  border-radius:12px;padding:0.6rem 0.85rem;
  display:flex;align-items:center;gap:0.5rem;
  white-space:nowrap;
  box-shadow:0 8px 32px rgba(0,0,0,0.4);
  font-size:0.78rem;
}
.fp-1{top:8%;right:-20px}
.fp-2{bottom:15%;left:-30px}
.fp-3{bottom:35%;right:-25px}
.fp-num{font-weight:800;font-size:1rem;color:var(--teal)}
.fp-lbl{color:var(--mist);font-size:0.7rem;line-height:1.3}
.fp-ico{font-size:1.1rem}

/* DIVIDER — route dots */
.route-divider{
  display:flex;align-items:center;justify-content:center;gap:0.5rem;
  padding:1rem 0;
}
.rd-dot{width:8px;height:8px;border-radius:50%;background:var(--navy4)}
.rd-dot.active{background:var(--teal);box-shadow:0 0 8px rgba(0,201,167,0.5)}
.rd-line{height:1px;width:40px;background:rgba(0,201,167,0.15)}

/* SECTIONS */
section{padding:6rem 0}
.wrap{max-width:1180px;margin:0 auto;padding:0 2rem}

.section-chip{
  display:inline-flex;align-items:center;gap:0.4rem;
  font-size:0.72rem;font-weight:700;letter-spacing:0.08em;color:var(--teal);
  background:rgba(0,201,167,0.08);border:1px solid rgba(0,201,167,0.15);
  border-radius:100px;padding:0.25rem 0.85rem;margin-bottom:1rem;
}
.section-h{
  font-size:clamp(1.9rem,3.5vw,2.7rem);font-weight:800;
  letter-spacing:-0.025em;line-height:1.1;margin-bottom:1rem;
}
.section-p{font-size:1rem;color:var(--mist);line-height:1.75;max-width:600px}

/* PROOF SECTION */
.proof-section{background:var(--navy2)}
.proof-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  border:1px solid rgba(0,201,167,0.08);border-radius:24px;
  overflow:hidden;margin-top:3.5rem;
}
.proof-cell{
  padding:2.5rem 2rem;
  border-right:1px solid rgba(0,201,167,0.08);
  position:relative;
}
.proof-cell:last-child{border-right:none}
.proof-cell::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,var(--teal),transparent);
  opacity:0;transition:opacity 0.3s;
}
.proof-cell:hover::before{opacity:1}
.proof-big{
  font-size:3rem;font-weight:900;letter-spacing:-0.04em;
  background:linear-gradient(135deg,var(--teal2),var(--teal));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:0.5rem;
}
.proof-big.amber-g{
  background:linear-gradient(135deg,var(--amber),#E8A020);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.proof-desc{font-size:0.82rem;color:var(--mist);line-height:1.5;font-weight:500}

/* QUOTE */
.quote-card{
  background:linear-gradient(135deg,rgba(0,201,167,0.07),rgba(0,201,167,0.02));
  border:1px solid rgba(0,201,167,0.15);border-radius:24px;
  padding:2.5rem;margin-top:2.5rem;
  display:grid;grid-template-columns:auto 1fr;gap:2rem;align-items:center;
}
.quote-icon{font-size:3rem;line-height:1}
.quote-text{
  font-size:1.15rem;font-weight:600;line-height:1.6;
  color:var(--offwhite);margin-bottom:0.6rem;
}
.quote-text em{color:var(--teal);font-style:normal}
.quote-by{font-size:0.78rem;color:var(--mist);font-weight:600;letter-spacing:0.03em}

/* HOW IT WORKS */
.how-section{background:var(--navy)}
.steps-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3.5rem;
}
.step-card{
  background:var(--navy2);border-radius:20px;padding:2rem;
  border:1px solid rgba(255,255,255,0.04);
  position:relative;overflow:hidden;
  transition:border-color 0.3s,transform 0.3s;
}
.step-card:hover{border-color:rgba(0,201,167,0.2);transform:translateY(-4px)}
.step-card::after{
  content:'';position:absolute;
  bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--teal),transparent);
  opacity:0;transition:opacity 0.3s;
}
.step-card:hover::after{opacity:1}

.step-num{
  font-size:3.5rem;font-weight:900;letter-spacing:-0.05em;
  color:rgba(0,201,167,0.08);line-height:1;margin-bottom:1rem;
  font-variant-numeric:tabular-nums;
}
.step-ico{font-size:1.8rem;margin-bottom:0.75rem}
.step-title{font-size:1.05rem;font-weight:700;margin-bottom:0.5rem}
.step-body{font-size:0.83rem;color:var(--mist);line-height:1.65}

/* COMMUNITY SECTION */
.community-section{background:var(--navy3)}
.community-inner{
  display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;
}
.community-messages{
  display:flex;flex-direction:column;gap:0.75rem;
}
.msg-bubble{
  background:var(--navy2);border-radius:16px;padding:0.9rem 1.1rem;
  border:1px solid rgba(255,255,255,0.05);
  max-width:85%;animation:slide-in 0.4s ease;
}
.msg-bubble.driver{
  align-self:flex-start;
  border-left:2px solid var(--teal);
}
.msg-bubble.passenger{
  align-self:flex-end;
  border-right:2px solid var(--amber);
}
@keyframes slide-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.msg-author{font-size:0.65rem;font-weight:700;color:var(--teal);margin-bottom:0.3rem;letter-spacing:0.05em}
.msg-author.amber-a{color:var(--amber)}
.msg-text{font-size:0.82rem;color:var(--offwhite);line-height:1.5}
.msg-meta{font-size:0.62rem;color:var(--mist);margin-top:0.3rem;text-align:right}

.location-share{
  background:rgba(0,201,167,0.05);border:1px solid rgba(0,201,167,0.15);
  border-radius:12px;padding:0.75rem;display:flex;align-items:center;gap:0.6rem;
}
.loc-ico{font-size:1.2rem}
.loc-text{font-size:0.75rem;color:var(--teal);font-weight:600}
.loc-sub{font-size:0.62rem;color:var(--mist)}

/* FOR WHOM */
.forwho-section{background:var(--navy)}
.forwho-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:3.5rem;
}
.who-card{
  background:var(--navy2);border-radius:24px;padding:2rem;
  border:1px solid rgba(255,255,255,0.04);
}
.who-header{
  display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;
  padding-bottom:1.25rem;border-bottom:1px solid rgba(255,255,255,0.05);
}
.who-ico-wrap{
  width:52px;height:52px;border-radius:16px;
  display:flex;align-items:center;justify-content:center;font-size:1.6rem;
  background:rgba(0,201,167,0.08);flex-shrink:0;
}
.who-title{font-size:1.05rem;font-weight:800}
.who-subtitle{font-size:0.72rem;color:var(--teal);font-weight:600;margin-top:0.1rem}
.who-list{list-style:none;display:flex;flex-direction:column;gap:0.65rem}
.who-list li{
  font-size:0.82rem;color:var(--mist);
  display:flex;align-items:flex-start;gap:0.6rem;line-height:1.5;
}
.who-list li::before{
  content:'';width:5px;height:5px;border-radius:50%;
  background:var(--teal);flex-shrink:0;margin-top:0.45em;
}

/* ROADMAP */
.roadmap-section{background:var(--navy2)}
.roadmap-track{
  position:relative;margin-top:3.5rem;
  display:grid;grid-template-columns:repeat(5,1fr);gap:0;
}
.roadmap-track::before{
  content:'';position:absolute;
  top:28px;left:10%;right:10%;height:2px;
  background:linear-gradient(90deg,var(--teal),rgba(0,201,167,0.1));
  z-index:0;
}
.rm-step{
  display:flex;flex-direction:column;align-items:center;text-align:center;
  padding:0 0.5rem;position:relative;z-index:1;
}
.rm-dot{
  width:56px;height:56px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:1.2rem;margin-bottom:1rem;flex-shrink:0;
  border:2px solid transparent;
  transition:all 0.3s;
}
.rm-dot.done{
  background:var(--teal);
  box-shadow:0 0 0 6px rgba(0,201,167,0.1);
}
.rm-dot.active{
  background:rgba(0,201,167,0.1);
  border-color:var(--teal);
  animation:pulse-rm 2s ease-in-out infinite;
}
.rm-dot.next{
  background:var(--navy3);border-color:rgba(255,255,255,0.1);
}
@keyframes pulse-rm{
  0%,100%{box-shadow:0 0 0 6px rgba(0,201,167,0.1)}
  50%{box-shadow:0 0 0 12px rgba(0,201,167,0.05)}
}
.rm-label{font-size:0.8rem;font-weight:700;color:var(--offwhite);margin-bottom:0.25rem}
.rm-sub{font-size:0.68rem;color:var(--mist);line-height:1.4}

/* CTA SECTION */
.cta-section{
  background:var(--navy);padding:8rem 0;
  position:relative;overflow:hidden;
}
.cta-bg-logo{
  position:absolute;
  right:-100px;top:50%;transform:translateY(-50%);
  width:500px;height:500px;object-fit:contain;
  opacity:0.04;
  pointer-events:none;
}
.cta-inner{
  position:relative;z-index:2;text-align:center;
  max-width:680px;margin:0 auto;
}
.cta-h{
  font-size:clamp(2rem,4vw,3.2rem);font-weight:900;
